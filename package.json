{
  "name": "dsh-readvideo",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：按需取字节阅读视频（Range 跳读 + 抽帧 + 语音转写），不下载整片",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "video",
    "video-understanding",
    "ffmpeg",
    "http-range",
    "multimodal",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaganaBloodedge/dsh-read-video.git"
  },
  "homepage": "https://github.com/RaganaBloodedge/dsh-read-video#readme",
  "bugs": {
    "url": "https://github.com/RaganaBloodedge/dsh-read-video/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "typescript": "^5.6.0",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
